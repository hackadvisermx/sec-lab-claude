# =============================================================================
# SecLab — plantilla de configuración
# =============================================================================
# `seclab init` copia este archivo a `.env` y genera los secretos.
# NUNCA versiones `.env`: está en .gitignore por una razón.
#
# Los valores de secreto se dejan VACÍOS a propósito. SecLab se niega a
# arrancar con un secreto vacío o con un valor de relleno tipo
# "change-this-password" o "changeme". No hay contraseñas por defecto.
# =============================================================================

# --- Identidad de la instancia -----------------------------------------------
# Nombre de proyecto de Docker Compose. Permite varias instancias de SecLab en
# la misma máquina sin que se pisen los contenedores ni los volúmenes.
SECLAB_PROJECT=seclab

# Perfil de imagen: lite | desktop | full | full-msf
SECLAB_PERFIL=lite

# Imagen a ejecutar. `seclab init` la calcula a partir del perfil y la versión.
SECLAB_IMAGE=seclab-lite:0.1.0

# Registry destino para publicar/descargar imágenes (vacío = registry local de
# pruebas, localhost:5000; ver docs/ci.md).
SECLAB_REGISTRY=

# --- Verificación de firma (Fase 8, 'seclab image verify') -------------------
# Cosign en modo keyless (OIDC de GitHub Actions): no hay clave privada que
# gestionar, pero verificar exige decir CONTRA QUÉ IDENTIDAD se firmó, o
# cualquier firma de cualquiera pasaría la comprobación. Rellena esto con el
# repositorio real del curso una vez tenga un remoto de Git configurado (ver
# docs/ci.md, sección "Firma y verificación").
#
# Regex de la identidad del certificado (el workflow de GitHub Actions que firmó).
# Ejemplo: ^https://github\.com/TU-ORGANIZACION/TU-REPO/\.github/workflows/.+@refs/tags/v.*$
SECLAB_COSIGN_IDENTIDAD_REGEX=

# Emisor OIDC. El de GitHub Actions casi nunca hace falta cambiarlo.
SECLAB_COSIGN_EMISOR=https://token.actions.githubusercontent.com

# --- Red y exposición --------------------------------------------------------
# Dirección de escucha. 127.0.0.1 significa "sólo esta máquina".
# Cambiarlo expone el laboratorio a tu red. Hazlo sólo si sabes lo que implica.
SECLAB_BIND=127.0.0.1

SECLAB_PUERTO_SSH=2222
SECLAB_PUERTO_WEB=8080
SECLAB_PUERTO_NOVNC=6080
SECLAB_PUERTO_CODE=8443
SECLAB_PUERTO_JUPYTER=8888

# --- Recursos ----------------------------------------------------------------
SECLAB_CPUS=2
SECLAB_MEM=4g

# --- Usuario y entorno -------------------------------------------------------
SECLAB_USUARIO=seclab
SECLAB_TZ=Europe/Madrid
SECLAB_WORKSPACE=./workspace

# Glifos de la barra de estado de tmux: powerline | ascii
# Los separadores Powerline necesitan una Nerd Font en el terminal del host.
# Si no la tienes, `seclab doctor` te ofrece la variante ascii, que se ve bien
# en cualquier fuente.
SECLAB_GLIFOS=powerline

# --- Copias de seguridad -----------------------------------------------------
# Dónde escribe `seclab backup`. Una copia contiene .env y la llave SSH en
# claro: se crea con permisos 600 y este directorio está en .gitignore.
# Si lo cambias, elige una ruta FUERA del workspace (si no, la copia se
# incluiría a sí misma; SecLab lo detecta y se niega).
SECLAB_BACKUP_DIR=

# --- Servicios opcionales -----------------------------------------------------
# Vacío significa «lo que corresponda al perfil»: `desktop`, `full` y `full-msf`
# traen escritorio, code-server y página de bienvenida; `lite` no trae ninguno.
# Escribe true o false para decidirlo tú y que el perfil no mande.
#
# Un servicio activado en un perfil que no lo trae **no arranca el laboratorio**:
# aborta con un mensaje que dice qué perfil usar. Es preferible a quedarse
# «unhealthy» sin explicación.
SECLAB_HABILITAR_DESKTOP=
SECLAB_HABILITAR_CODE=
SECLAB_HABILITAR_WEB=
SECLAB_HABILITAR_JUPYTER=

# Estos dos siguen desactivados por defecto y son opt-in explícito.
SECLAB_HABILITAR_MCP=false
SECLAB_HABILITAR_TAILSCALE=false

# Resolución del escritorio, tal como la verá el navegador por noVNC.
SECLAB_RESOLUCION=1440x900

# --- Secretos (generados por `seclab init`; nunca los rellenes a mano) -------
SECLAB_VNC_PASSWORD=
SECLAB_CODE_PASSWORD=
SECLAB_JUPYTER_TOKEN=
SECLAB_MCP_TOKEN=

# Clave de autenticación de Tailscale. Efímera y de mínimo privilegio.
# Se crea en la consola de Tailscale; no la generes ni la compartas por chat.
TAILSCALE_AUTH_KEY=

# --- VPN (Fase 7) -------------------------------------------------------------
# true|false. Concede a 'lab' NET_ADMIN y /dev/net/tun (docker-compose.vpn.yml)
# — lo mínimo que 'seclab-vpn', dentro de la imagen, necesita para levantar un
# túnel. En false (por defecto), 'lab' no tiene esas capacidades: no las
# necesita salvo que vayas a usar una VPN de plataforma.
#
# No hace falta ponerlo a mano: 'seclab vpn up' lo activa solo la primera vez
# que lo necesita (pide confirmación, porque recrea 'lab' para concedérselas —
# se pierde cualquier shell abierta en ese momento, no tu directorio personal
# ni tu workspace). Una vez en true, no se desactiva solo: seguirá concedido en
# arranques posteriores hasta que lo pongas en false tú mismo y reinicies.
SECLAB_HABILITAR_VPN=false

# Ni esta variable ni ninguna otra guardan qué perfil está activo: con el
# diseño actual pueden estar varios a la vez (vpnhtb, vpntry, vpncli) y un
# único valor en .env no podría representarlo. La fuente de verdad es
# /run/seclab-vpn/ DENTRO del contenedor; se consulta con
# 'seclab vpn list'/'status', que hacen `docker exec` — nunca leyendo este
# archivo. La configuración de cada perfil vive en vpn/<perfil>/ y nunca en
# Git.
