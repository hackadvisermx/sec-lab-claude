# --- Secretos y configuración local ---
.env
.env.local
/secretos/
*.pem
*.key
*.p12
*.pfx
*.crt
*.csr
*.ovpn

# --- VPN: configuraciones y estado (nunca en Git) ---
# Anclados con / a la raíz del repositorio: sin la barra inicial, el patrón
# 'vpn/' coincidiría a cualquier profundidad y se tragaría templates/vpn/,
# que sí debe versionarse.
/vpn/
/vpn-state/

# --- Datos del usuario ---
/workspace/
/backups/

# --- Estado de servicios opcionales ---
/tailscale-state/
/mcp-state/

# --- Terraform ---
# Con ** para cubrir también los módulos por proveedor (terraform/digitalocean/,
# terraform/gcp/, terraform/oracle/ en la Fase 11), no sólo la raíz de
# terraform/: sin el doble asterisco, un terraform.tfvars con el token real de
# un alumno dentro de terraform/digitalocean/ se habría colado en Git.
/terraform/**/.terraform/
/terraform/**/*.tfstate
/terraform/**/*.tfstate.backup
/terraform/**/*.tfvars
# .terraform.lock.hcl NO coincide con ninguno de los patrones de arriba: se
# versiona a propósito (práctica recomendada de Terraform, fija qué versión
# exacta de cada provider se ha usado y verificado).
# Los ejemplos, evidentemente ficticios, sí se versionan.
!/terraform/**/*.tfvars.example
!/terraform/**/backend.hcl.example

# --- Lenguajes y editores ---
__pycache__/
*.pyc
node_modules/
.DS_Store
.idea/
.vscode/
