<?xml version="1.0" encoding="UTF-8"?>
<!--
  SecLab — escritorio: iconos y fondo

  Dos decisiones:

  - Se muestran los accesos directos de ~/Desktop (style=2) y se ocultan
    «Sistema de archivos», la papelera y los dispositivos extraíbles, que en un
    contenedor no llevan a ninguna parte útil. Se conserva «Home».
  - Fondo de color plano en lugar de imagen. Sin esto el escritorio sale negro,
    que parece un fallo; el color es el mismo de la terminal y de la barra de
    tmux, así que el conjunto se ve deliberado.

  El nombre del monitor (VNC-0) es el que crea Xvnc. Si algún día cambiara, el
  fondo volvería a negro: molesto, pero inofensivo.
-->
<channel name="xfce4-desktop" version="1.0">
  <property name="desktop-icons" type="empty">
    <property name="style" type="int" value="2"/>
    <property name="icon-size" type="uint" value="48"/>
    <property name="file-icons" type="empty">
      <property name="show-filesystem" type="bool" value="false"/>
      <property name="show-trash" type="bool" value="false"/>
      <property name="show-removable" type="bool" value="false"/>
      <property name="show-home" type="bool" value="true"/>
    </property>
  </property>
  <property name="backdrop" type="empty">
    <property name="single-workspace-mode" type="bool" value="true"/>
    <property name="screen0" type="empty">
      <property name="monitorVNC-0" type="empty">
        <property name="workspace0" type="empty">
          <property name="image-style" type="int" value="0"/>
          <property name="color-style" type="int" value="0"/>
          <property name="rgba1" type="array">
            <value type="double" value="0.102"/>
            <value type="double" value="0.106"/>
            <value type="double" value="0.149"/>
            <value type="double" value="1"/>
          </property>
        </property>
      </property>
    </property>
  </property>
</channel>
