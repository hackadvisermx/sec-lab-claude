# : << 'EOF'
# Oh my tmux! Local customization
# https://github.com/gpakosz/.tmux
# ------------------------------------------------------------------------------

# -- navigation ----------------------------------------------------------------

# if you're running tmux within iTerm2
#set -g terminal-overrides 'iterm*:smcup@:rmcup@'

# -- window & pane creation ---------------------------------------------------

tmux_conf_new_window_retain_current_path=false
tmux_conf_new_pane_retain_current_path=true
tmux_conf_new_pane_reconnect_ssh=false
tmux_conf_new_session_prompt=false

# -- display -------------------------------------------------------------------

# RGB 24-bit colour support
tmux_conf_24b_colour=true

# -- theming -------------------------------------------------------------------

# enable or disable powerline symbols
tmux_conf_theme_use_nerd_fonts=true

# Separadores Powerline / Nerd Font
tmux_conf_theme_left_separator_main=''
tmux_conf_theme_left_separator_sub=''
tmux_conf_theme_right_separator_main=''
tmux_conf_theme_right_separator_sub=''

# Paleta de colores Tokyo Night / Modern Dark
tmux_conf_theme_colour_1="#1a1b26"    # dark background
tmux_conf_theme_colour_2="#24283b"    # surface
tmux_conf_theme_colour_3="#565f89"    # gray / muted
tmux_conf_theme_colour_4="#7aa2f7"    # blue
tmux_conf_theme_colour_5="#e0af68"    # yellow / orange
tmux_conf_theme_colour_6="#1a1b26"    # dark
tmux_conf_theme_colour_7="#c0caf5"    # text foreground
tmux_conf_theme_colour_8="#1a1b26"    # dark
tmux_conf_theme_colour_9="#bb9af7"    # purple
tmux_conf_theme_colour_10="#f7768e"   # red / pink
tmux_conf_theme_colour_11="#9ece6a"   # green
tmux_conf_theme_colour_12="#565f89"   # muted
tmux_conf_theme_colour_13="#c0caf5"   # text
tmux_conf_theme_colour_14="#1a1b26"   # dark
tmux_conf_theme_colour_15="#24283b"   # surface
tmux_conf_theme_colour_16="#f7768e"   # red
tmux_conf_theme_colour_17="#c0caf5"   # text

# Bordes de paneles
tmux_conf_theme_pane_border="#24283b"
tmux_conf_theme_pane_active_border="#7aa2f7"

# Barra de estado
tmux_conf_theme_status_bg="#1a1b26"
tmux_conf_theme_status_fg="#c0caf5"

# Formato de ventanas inactivas y activas con iconos
tmux_conf_theme_window_status_fg="#565f89"
tmux_conf_theme_window_status_bg="#1a1b26"
tmux_conf_theme_window_status_format=' #I #W#{?window_bell_flag, 🔔,}#{?window_zoomed_flag, 🔍,} '

tmux_conf_theme_window_status_current_fg="#1a1b26"
tmux_conf_theme_window_status_current_bg="#7aa2f7"
tmux_conf_theme_window_status_current_attr="bold"
tmux_conf_theme_window_status_current_format=' ⚡ #I #W#{?window_zoomed_flag, 🔍,} '

# Indicadores de estado con iconos
tmux_conf_theme_status_left=' 🚀 #S '
tmux_conf_theme_status_left_fg='#1a1b26'
tmux_conf_theme_status_left_bg='#9ece6a'
tmux_conf_theme_status_left_attr='bold'

tmux_conf_theme_status_right=' #{prefix}#{pairing}#{synchronized} 📂 #{pane_current_path}  👤 #{username}  🕒 %H:%M '
tmux_conf_theme_status_right_fg='#c0caf5,#c0caf5,#1a1b26'
tmux_conf_theme_status_right_bg='#24283b,#565f89,#7aa2f7'
tmux_conf_theme_status_right_attr='none,none,bold'

tmux_conf_theme_prefix='⚡ '
tmux_conf_theme_root='👤 '
tmux_conf_theme_synchronized='🔒 '

# -- custom user settings ------------------------------------------------------

# Activar soporte de ratón / mouse por defecto (seleccionar paneles, redimensionar y scroll)
set -g mouse on

# UTF-8 & True Color
set -q -g status-utf8 on
setw -q -g utf8 on
set -g default-terminal "screen-256color"
set -ga terminal-overrides ",*256col*:Tc"
set -g status-position bottom
