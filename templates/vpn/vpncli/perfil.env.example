# Perfil de VPN: cliente / engagement
# Copia este archivo a perfil.env y ajústalo. No lo versiones.

SECLAB_VPN_NOMBRE="Cliente"

# Ruta del .ovpn, relativa a este directorio.
SECLAB_VPN_CONFIG="vpncli.ovpn"

# Rangos del entorno del cliente. Estos te los da la organización: no hay
# ejemplo razonable que poner aquí.
SECLAB_VPN_RANGOS=""

# Archivo de credenciales si el .ovpn usa auth-user-pass.
# Dos líneas: usuario y contraseña. Permisos 600.
SECLAB_VPN_CREDENCIALES=""

SECLAB_VPN_DNS=""

# Aceptar la ruta por defecto que empuje el túnel (redirect-gateway).
# Con `true`, TODO tu tráfico sale por esta VPN, no sólo los rangos declarados.
# Actívalo sólo si el acceso al entorno lo exige y sabes lo que implica.
SECLAB_VPN_RUTA_DEFECTO=false
