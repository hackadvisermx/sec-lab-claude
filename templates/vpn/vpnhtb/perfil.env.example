# Perfil de VPN: Hack The Box
# Copia este archivo a perfil.env y ajústalo. No lo versiones.

SECLAB_VPN_NOMBRE="Hack The Box"

# Ruta del .ovpn descargado, relativa a este directorio.
SECLAB_VPN_CONFIG="vpnhtb.ovpn"

# Rangos que deben enrutarse por el túnel, separados por comas.
#
# ATENCIÓN: estos valores son un EJEMPLO, no una verdad fija. Hack The Box
# cambia sus rangos y cada producto (Machines, Starting Point, Pro Labs) usa
# los suyos. Conecta, ejecuta `seclab vpn status` y pon aquí lo que veas.
#
# Punto de partida habitual:
SECLAB_VPN_RANGOS="10.10.10.0/24,10.10.14.0/23,10.129.0.0/16"

# DNS del túnel. Déjalo vacío si no lo necesitas: menos superficie de fuga.
SECLAB_VPN_DNS=""
