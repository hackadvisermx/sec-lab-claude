# Perfil de VPN: TryHackMe
# Copia este archivo a perfil.env y ajústalo. No lo versiones.

SECLAB_VPN_NOMBRE="TryHackMe"

# Ruta del .ovpn descargado, relativa a este directorio.
SECLAB_VPN_CONFIG="vpntry.ovpn"

# Rangos que deben enrutarse por el túnel, separados por comas.
#
# ATENCIÓN: EJEMPLO orientativo. TryHackMe usa rangos distintos según la sala y
# el tipo de red. Conecta, ejecuta `seclab vpn status` y ajusta esta línea.
#
# Punto de partida habitual:
SECLAB_VPN_RANGOS="10.10.0.0/16"

# Las salas de red dedicada añaden rangos propios. Ejemplo de cómo ampliarlo:
# SECLAB_VPN_RANGOS="10.10.0.0/16,10.200.0.0/16"

SECLAB_VPN_DNS=""
