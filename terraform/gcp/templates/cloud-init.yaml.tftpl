#cloud-config
# =============================================================================
# SecLab — bootstrap de la instancia GCP (cloud-init)
# =============================================================================
# Generado por terraform/gcp/main.tf a partir de esta plantilla, publicado en
# la metadata `user-data` de la instancia (ver comentario de main.tf sobre
# por qué user-data/cloud-init y no `startup-script`).
#
# Esta plantilla es DELIBERADAMENTE casi idéntica a
# terraform/digitalocean/templates/cloud-init.yaml.tftpl: instalar Docker,
# traer la imagen de SecLab por digest/tag inmutable desde ${seclab_registro},
# y arrancarla mediante un servicio systemd. La única diferencia real de
# fondo está en el bloque de autodestrucción opcional (ver más abajo): GCP
# permite que la instancia se borre a sí misma usando su PROPIA identidad de
# cuenta de servicio (token de metadata), sin depositar ningún token estático
# en disco — a diferencia del mecanismo de DigitalOcean.
#
# Idempotencia: igual que en DigitalOcean — apt-get es idempotente, el
# repositorio de Docker se añade sólo si no existe, el contenedor se
# identifica por nombre fijo y se recrea con `docker rm -f` previo tolerante
# a fallo, y `systemctl enable --now` no hace nada si ya está activo.
#
# Secretos: aquí NO se escribe ninguna contraseña permanente. Las credenciales
# de VNC/code-server/Jupyter las genera el propio contenedor en su primer
# arranque (docker/entrypoint.sh), igual que en local y en DigitalOcean.
# `seclab cloud connect --provider gcp` hace SSH y las muestra igual que en
# DigitalOcean.
# =============================================================================

package_update: true
package_upgrade: false

packages:
  - ca-certificates
  - curl
  - gnupg
  - at

write_files:
  - path: /etc/seclab-cloud/entorno
    permissions: '0600'
    owner: root:root
    content: |
      SECLAB_IMAGEN_REF=${seclab_imagen_ref}
      SECLAB_NOMBRE_CONTENEDOR=${nombre_contenedor}
      SECLAB_OWNER=${owner}
      SECLAB_PROPOSITO=${proposito}
      SECLAB_FECHA_EXPIRACION=${fecha_expiracion}
      SECLAB_PUERTO_SSH=${puerto_ssh}

  - path: /etc/systemd/system/seclab.service
    permissions: '0644'
    owner: root:root
    content: |
      [Unit]
      Description=SecLab (contenedor docente)
      After=docker.service network-online.target
      Requires=docker.service
      Wants=network-online.target

      [Service]
      EnvironmentFile=/etc/seclab-cloud/entorno
      ExecStartPre=-/usr/bin/docker rm -f ${nombre_contenedor}
      ExecStartPre=/usr/bin/docker pull $${SECLAB_IMAGEN_REF}
      ExecStart=/usr/bin/docker run --rm --name $${SECLAB_NOMBRE_CONTENEDOR} \
        -p 127.0.0.1:8080:8080 \
        -p 127.0.0.1:6080:6080 \
        -p 127.0.0.1:8443:8443 \
        -p 127.0.0.1:8888:8888 \
        -p $${SECLAB_PUERTO_SSH}:22 \
        -v seclab-home:/home/seclab \
        -v seclab-workspace:/workspace \
        $${SECLAB_IMAGEN_REF}
      ExecStop=/usr/bin/docker stop -t 30 ${nombre_contenedor}
      Restart=on-failure
      RestartSec=5s
      TimeoutStartSec=300

      [Install]
      WantedBy=multi-user.target

  # Marca que 'seclab cloud wait' comprueba por SSH, igual que en DigitalOcean.
  - path: /etc/seclab-cloud/bootstrap-completo
    permissions: '0644'
    owner: root:root
    content: |
      pendiente

runcmd:
  # --- Docker Engine, oficial, no el paquete distro ---
  - |
    if ! command -v docker >/dev/null 2>&1; then
      install -m 0755 -d /etc/apt/keyrings
      if [ ! -f /etc/apt/keyrings/docker.gpg ]; then
        curl -fsSL https://download.docker.com/linux/ubuntu/gpg | gpg --dearmor -o /etc/apt/keyrings/docker.gpg
        chmod a+r /etc/apt/keyrings/docker.gpg
      fi
      if [ ! -f /etc/apt/sources.list.d/docker.list ]; then
        . /etc/os-release
        echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.gpg] https://download.docker.com/linux/ubuntu $${VERSION_CODENAME} stable" \
          > /etc/apt/sources.list.d/docker.list
      fi
      apt-get update -y
      apt-get install -y docker-ce docker-ce-cli containerd.io docker-compose-plugin
    fi
  - systemctl enable --now docker

  # --- Volúmenes nombrados: se crean si no existen, nunca se recrean ---
  - docker volume inspect seclab-home >/dev/null 2>&1 || docker volume create seclab-home
  - docker volume inspect seclab-workspace >/dev/null 2>&1 || docker volume create seclab-workspace

  # --- Autodestrucción opcional por TTL (desactivada salvo opt-in expreso) ---
  # A diferencia de DigitalOcean, NO se deposita ningún token estático de API
  # en disco: se usa el token de acceso de la cuenta de servicio de la propia
  # instancia (servido por el servidor de metadata de GCP, de corta vida, y
  # nunca escrito a disco). Para que esto funcione hace falta que la cuenta
  # de servicio adjunta tenga scope 'compute' (ver main.tf,
  # habilitar_autodestruccion) Y un rol IAM que permita
  # 'compute.instances.delete' sobre esta instancia — concedido FUERA de este
  # módulo, por un administrador del proyecto. Ver docs/cloud.md, "TTL y
  # autodestrucción".
  %{~ if habilitar_autodestruccion ~}
  - |
    cat > /etc/seclab-cloud/autodestruir.sh <<'AUTODESTRUIR'
    #!/bin/sh
    set -eu
    MD="http://metadata.google.internal/computeMetadata/v1"
    ZONE=$(curl -fsS -H 'Metadata-Flavor: Google' "$MD/instance/zone" | sed 's#.*/##')
    NAME=$(curl -fsS -H 'Metadata-Flavor: Google' "$MD/instance/name")
    PROJECT=$(curl -fsS -H 'Metadata-Flavor: Google' "$MD/project/project-id")
    TOKEN=$(curl -fsS -H 'Metadata-Flavor: Google' "$MD/instance/service-accounts/default/token" \
      | sed -n 's/.*"access_token"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p')
    curl -fsS -X DELETE \
      -H "Authorization: Bearer $TOKEN" \
      "https://compute.googleapis.com/compute/v1/projects/$PROJECT/zones/$ZONE/instances/$NAME"
    AUTODESTRUIR
    chmod 700 /etc/seclab-cloud/autodestruir.sh
    echo "/etc/seclab-cloud/autodestruir.sh" | at -t "$(date -d '${fecha_expiracion} 00:05' '+%Y%m%d%H%M' 2>/dev/null || date -j -f '%Y-%m-%d %H:%M' "${fecha_expiracion} 00:05" '+%Y%m%d%H%M')"
  %{~ endif ~}

  - systemctl daemon-reload
  - systemctl enable --now seclab.service

  # Marca de fin: sólo se escribe si todo lo anterior no ha fallado.
  - echo "listo $(date -u '+%Y-%m-%dT%H:%M:%SZ')" > /etc/seclab-cloud/bootstrap-completo

final_message: "SecLab bootstrap completado en $UPTIME segundos"
