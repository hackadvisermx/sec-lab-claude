# =============================================================================
# SecLab — ejemplo de terraform.tfvars (Oracle Cloud / OCI)
# =============================================================================
# Copia a terraform.tfvars (ya está en .gitignore: /terraform/**/*.tfvars) y
# sustituye TODOS los valores. Los de abajo son evidentemente ficticios.
#
# Credenciales: SecLab NUNCA lee ni busca '~/.oci/config' por su cuenta (ver
# lib/cloud.sh). Rellena aquí tenancy_ocid/user_ocid/fingerprint/
# private_key_path (clásico "API key"), o define las variables de entorno
# estándar del provider (OCI_CLI_CONFIG_FILE, TF_VAR_...), fuera de este
# archivo.
# =============================================================================

tenancy_ocid = "ocid1.tenancy.oc1..REEMPLAZA0000000000000000000000000000000000000000000000000000000"
user_ocid    = "ocid1.user.oc1..REEMPLAZA00000000000000000000000000000000000000000000000000000000"
fingerprint  = "aa:bb:cc:dd:00:11:22:33:44:55:66:77:88:99:aa:bb"
# Ruta FUERA de este repositorio; nunca la copies dentro de terraform/oracle/.
private_key_path = "/ruta/fuera/del/repo/oci_api_key.pem"

region           = "us-ashburn-1"
compartment_ocid = "ocid1.compartment.oc1..REEMPLAZA000000000000000000000000000000000000000000000000000"

owner            = "tu-nombre-aqui"
curso            = "ciberseguridad-2026"
fecha_expiracion = "2026-12-31"

# Ampere ARM, Always Free si no excedes el límite del tenancy (ver
# docs/cloud.md — el free tier cambia, no lo des por garantizado).
shape      = "VM.Standard.A1.Flex"
ocpus      = 2
memoria_gb = 12

# Resuelve el OCID de Ubuntu 22.04 PARA TU REGIÓN, ver README.md de este
# directorio ('oci compute image list ...').
image_ocid = "ocid1.image.oc1.REGION.REEMPLAZA000000000000000000000000000000000000000000000000000"

ssh_public_key = "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAREEMPLAZA-CON-TU-LLAVE-PUBLICA tu-llave@tu-maquina"

seclab_registry   = "registry.example.invalid/seclab"
seclab_imagen_ref = "registry.example.invalid/seclab/seclab-lite@sha256:REEMPLAZA0000000000000000000000000000000000000000000000000000"

# Desactivada por defecto: ver docs/cloud.md, "TTL y autodestrucción" — y
# recuerda que además exige un Dynamic Group + Policy fuera de Terraform.
habilitar_autodestruccion = false
